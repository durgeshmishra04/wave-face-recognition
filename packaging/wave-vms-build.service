[Unit]
Description=Wave VMS compiled backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wave-vms
Group=wave-vms
Environment=WAVE_RUNTIME_DIR=/var/lib/wave-vms
WorkingDirectory=/var/lib/wave-vms
ExecStart=/opt/wave-vms/current/wave-vms
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wave-vms

[Install]
WantedBy=multi-user.target
