[Unit]
Description=Wave VMS Python source backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wave-vms
Group=wave-vms
Environment=WAVE_RUNTIME_DIR=/var/lib/wave-vms
WorkingDirectory=/opt/wave-vms/source
ExecStart=/opt/wave-vms/source/.venv/bin/python /opt/wave-vms/source/app.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wave-vms

[Install]
WantedBy=multi-user.target
