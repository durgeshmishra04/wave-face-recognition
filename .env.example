HOST=0.0.0.0
PORT=5000
# WAVE_RUNTIME_DIR is set by the service unit or process environment.

POSTGRES_HOST=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Set these for an existing deployment; blank values do not create default accounts.
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD=
USER_LOGIN_USERNAME=
USER_LOGIN_PASSWORD=

# Configure the public URL used in event image links.
PUBLIC_BASE_URL=

# Relative paths are resolved under WAVE_RUNTIME_DIR.
FIREBASE_SERVICE_ACCOUNT=pythonai.json
INSIGHTFACE_HOME=.insightface
PERSON_MODEL=yolo11n.pt
VEHICLE_MODEL_PATH=yolo26l.pt
FALL_MODEL_PATH=yolo11m-pose.pt
PPE_MODEL_PATH=yolo26n_ppe.pt
SMOKE_FIRE_MODEL_PATH=salahyolo26.pt
OBJECT_THEFT_MODEL_PATH=barrel.pt

# Provide a value only when the camera configuration omits its NVR address.
NVR_IP=
NVR_USERNAME=alcon
ALCON_PASSWORD=CHANGE_ME
